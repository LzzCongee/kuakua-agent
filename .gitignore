# ==================== Python ====================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip.ini

# ==================== 虚拟环境 ====================
.venv/
venv/
ENV/
env/

# ==================== 环境变量（含敏感信息） ====================
.env
.env.local
.env.*.local

# ==================== 数据库 ====================
*.db
*.sqlite
*.sqlite3

# ==================== IDE ====================
.vscode/
.idea/
*.swp
*.swo
*~

# ==================== 日志 ====================
*.log
logs/

# 但保留 logs/.gitkeep（确保目录结构存在）
!logs/.gitkeep

# ==================== 操作系统 ====================
.DS_Store
Thumbs.db

# ==================== Docker ====================
# SSL 证书文件（敏感内容，不追踪）
nginx/certs/*.pem
# 但保留 nginx/certs/.gitkeep（占位文件）
!nginx/certs/.gitkeep

# ==================== Linting / 类型检查 ====================
.mypy_cache/
.ruff_cache/

# ==================== Qoder ====================
.qoder/

# ==================== 以下文件应被 Git 追踪（不被忽略） ====================
# nginx/ 下的配置文件（nginx.conf, conf.d/*.conf）—— 基础设施即代码
# .github/workflows/ 下的 CI/CD 工作流 —— 自动部署配置
# Dockerfile, docker-compose.yml —— 容器化部署配置
# .env.example —— 环境变量模板（不含敏感信息）
