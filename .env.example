# 魔搭社区 API Key
MODELSCOPE_API_KEY=your_api_key_here

# AI 服务基础 URL（魔搭社区 OpenAI 兼容接口）
AI_BASE_URL=https://api-inference.modelscope.cn/v1

# AI 模型名称（魔搭社区模型格式）
AI_MODEL=deepseek-ai/DeepSeek-V3.2

# AI 视觉模型名称（用于处理图片等视觉任务）
AI_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# 数据库连接 URL
# 开发环境：sqlite:///./kuakua.db
# 生产环境：postgresql+asyncpg://kuakua:kuakua123@db:5432/kuakua
DATABASE_URL=sqlite:///./kuakua.db

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000

# 管理后台 API Key（用于 X-Admin-Key 认证）
ADMIN_API_KEY=changeme

# PostgreSQL 密码（docker-compose 使用）
DB_PASSWORD=kuakua123
