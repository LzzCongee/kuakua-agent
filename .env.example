# ===== 聊天文本生成（DeepSeek 官方） =====
AI_CHAT__API_KEY=CHANGE_ME_IN_PRODUCTION
AI_CHAT__BASE_URL=https://api.deepseek.com/v1
AI_CHAT__MODEL=deepseek-v4-flash
AI_CHAT__TIMEOUT=30

# ===== 视觉多模态 =====
AI_VISION__API_KEY=CHANGE_ME_IN_PRODUCTION
AI_VISION__BASE_URL=https://api.siliconflow.cn/v1
AI_VISION__MODEL=Qwen/Qwen3-VL-8B-Instruct
AI_VISION__TIMEOUT=60

# ===== 记忆提取（DeepSeek 官方） =====
AI_EXTRACT__API_KEY=CHANGE_ME_IN_PRODUCTION
AI_EXTRACT__BASE_URL=https://api.deepseek.com/v1
AI_EXTRACT__MODEL=deepseek-v4-flash
AI_EXTRACT__TIMEOUT=15

# ===== 纯 ASR 语音识别（火山引擎 BigModel Flash） =====
# APP ID       → 对应 X-Api-App-Key header，也用作 user.uid
# Access Token → 对应 X-Api-Access-Key header
# Secret Key   → v3 HTTP 接口不使用（仅 v2 WebSocket 签名需要）
PURE_ASR__APP_ID=CHANGE_ME_IN_PRODUCTION
PURE_ASR__ACCESS_TOKEN=CHANGE_ME_IN_PRODUCTION
PURE_ASR__BASE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
PURE_ASR__RESOURCE_ID=volc.bigasr.auc_turbo
PURE_ASR__MODEL=bigmodel
PURE_ASR__TIMEOUT=30

# 记忆提取控制参数
AI_EXTRACT_ENABLED=true
AI_EXTRACT_KEYWORD_FALLBACK=true
AI_EXTRACT_TEMPERATURE=0.1
AI_EXTRACT_MAX_TOKENS=200

# 数据库路径
DATABASE_URL=sqlite:///./kuakua.db

# supermemory MCP 配置
SUPERMEMORY_URL=http://106.55.151.27/sse
SUPERMEMORY_TOKEN=CHANGE_ME_IN_PRODUCTION
SUPERMEMORY_ENABLED=true
SUPERMEMORY_TIMEOUT=15.0
SUPERMEMORY_TOP_K=3

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000

# 日志配置
LOG_LEVEL=DEBUG

# 管理后台 API Key（用于 X-Admin-Key 认证，生产环境必须修改！）
ADMIN_API_KEY=CHANGE_ME_IN_PRODUCTION

# 微信小程序配置（用于 wx.login code 换 openid）
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# PostgreSQL 密码（docker-compose 使用）
DB_PASSWORD=kuakua123

# ==================== CloudBase 配置 ====================
USE_CLOUDBASE=true
CLOUDBASE_ENV_ID=dev-kuakua-d1gmvqyrha28477fe
CLOUDBASE_SECRET_ID=your_secret_id
CLOUDBASE_SECRET_KEY=your_secret_key
